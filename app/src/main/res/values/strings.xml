    <!-- Ruxsatlar Markazi -->
    <string name="permissions_title">Xavfsizlik va Ruxsatlar</string>
    <string name="permissions_subtitle">Ilova to\'liq va xavfsiz ishlashi uchun zarur ruxsatnomalar</string>
    
    <string name="perm_accessibility_title">1. Maxsus Imkoniyatlar (Accessibility)</string>
    <string name="perm_accessibility_desc">Telefon ekranini boshqarish, tugmalarni bosish, matn yozish va videolarni minutiga o\'tkazish uchun zarur.</string>
    <string name="btn_open_accessibility">Sozlamalarga O\'tish</string>

    <string name="perm_overlay_title">2. Boshqa Ilovalar Ustida Ko\'rinish (Overlay)</string>
    <string name="perm_overlay_desc">Boshqa ilovada (YouTube, Telegram) turganda "Hey AI" deganingizda animatsiyalik AI orb ko\'rinishi uchun.</string>
    <string name="btn_grant_overlay">Overlay Ruxsati</string>

    <string name="perm_audio_title">3. Mikrofon va Ovoz Yozish</string>
    <string name="perm_audio_desc">O\'zbek, rus va ingliz tillaridagi buyruqlaringizni aniq qabul qilish uchun.</string>
    <string name="btn_grant_mic">Mikrofon Ruxsati</string>

    <string name="perm_battery_title">4. Orqa Fonda Ishlash (Batareya)</string>
    <string name="perm_battery_desc">Boshqa ilovalar bilan ishlayotganda tizim AI ni to\'xtatib qo\'ymasligi uchun batareya cheklovini yechish.</string>
    <string name="btn_ignore_battery">Cheklovni Yechish</string>

    <string name="perm_notification_title">5. Bildirishnomalar</string>
    <string name="perm_notification_desc">Orqa fon xizmati uzluksiz va barqaror ishlashi uchun doimiy status ko\'rsatish.</string>
    <string name="btn_grant_notification">Xabarnoma Ruxsati</string>

