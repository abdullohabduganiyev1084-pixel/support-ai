    <!-- Google Play Protect & Android Xavfsizlik Talablariga mos tavsif -->
    <string name="accessibility_service_description">Support AI ilovasi foydalanuvchining ovozli buyruqlari ("YouTubeni och", "Telegramda yoz", "Videoga o\'tkaz") orqali telefon ekranini ovoz bilan qulay boshqarish uchun Maxsus Imkoniyatlar (Accessibility) xizmatidan foydalanadi. Ilova hech qanday shaxsiy ma\'lumotlarni to\'plamaydi, serverga jo\'natmaydi va 100% xavfsizdir.</string>

    <!-- Splash & Get Started -->
    <string name="welcome_title">Support AI Assistant</string>
    <string name="welcome_tagline">Kelajak ovozli intellekti sizning ixtiyoringizda</string>
    <string name="welcome_desc">Telefoningizdagi barcha ilovalarni — YouTube, Telegram, Galereya, Sozlamalarni bitta ovozli buyruq bilan to\'liq nazorat qiling.</string>
