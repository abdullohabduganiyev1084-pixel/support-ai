<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Glowing Animated Floating AI Orb -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_orb"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp">

        <ImageView
            android:id="@+id/iv_orb_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/support_ai_logo"
            android:contentDescription="@string/app_name" />
    </androidx.cardview.widget.CardView>

    <!-- Jonli Gapirish va Javob Berish Buluti -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_speech_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:cardBackgroundColor="#1A2234"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="240dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tv_overlay_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Support AI"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_overlay_speech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Eshitmoqdaman..."
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
