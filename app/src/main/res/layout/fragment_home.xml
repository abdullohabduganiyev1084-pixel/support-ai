<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_fluid"
    android:padding="20dp">

    <!-- Yuqoridagi Liquid Glass Status Paneli -->
    <LinearLayout
        android:id="@+id/panel_top_glass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_liquid_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="SUPPORT AI"
                android:textColor="@color/siri_cyan"
                android:textSize="15sp"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tv_ai_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="AI Faol (Erkak Ovozi)"
                android:textColor="@color/neon_green"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_ai_master"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            app:thumbTint="@color/siri_cyan"
            app:trackTint="@color/siri_blue" />
    </LinearLayout>

    <!-- Markaziy Siri Animatsiyasi (Katta Suyuq Nurlanuvchi Orb) -->
    <FrameLayout
        android:id="@+id/center_orb_container"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_centerInParent="true">

        <!-- Siri Wave View -->
        <com.supportai.assistant.utils.SiriWaveOrbView
            android:id="@+id/siri_orb_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Markaziy mikrofon tugmasi (Bosib gapirish uchun) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_mic_center"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            app:cardCornerRadius="36dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="#0D111A">

            <ImageView
                android:id="@+id/iv_mic_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/siri_cyan"
                android:contentDescription="Speak" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- "Hey AI" chaqiruv eslatmasi -->
    <TextView
        android:id="@+id/tv_wake_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/center_orb_container"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="🎙️ 'Hey AI' deng yoki shar ustiga bosing"
        android:textColor="@color/siri_cyan"
        android:textSize="13sp" />

    <!-- Pastdagi Jonli Suhbat va Natija Liquid Glass Kartasi -->
    <LinearLayout
        android:id="@+id/card_live_speech"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_liquid_glass"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tv_transcript_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Siz aytgan buyruq:"
            android:textColor="@color/text_glass_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Eshitmoqdaman... Gapiring..."
            android:textColor="@color/text_glass_primary"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#22FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="AI Erkak Ovozli Javobi:"
            android:textColor="@color/siri_cyan"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_ai_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-bold"
            android:text="Assalomu alaykum! Nima buyruq bajaramiz?"
            android:textColor="@color/neon_green"
            android:textSize="15sp" />
    </LinearLayout>

</RelativeLayout>
