<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_fluid"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="AI SOZLAMALARI"
            android:textColor="@color/siri_cyan"
            android:textSize="22sp"
            android:letterSpacing="0.04" />

        <!-- 1. Google Gemini API Key Sozlamasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_liquid_glass"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="⚡ Google Gemini AI (API Key)"
                android:textColor="@color/text_glass_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="AIning o'ta aqlli bo'lishi va barcha murakkab buyruqlarni erkin tushunishi uchun Gemini API kalitingizni kiriting."
                android:textColor="@color/text_glass_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_gemini_api_key"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dark_fluid"
                android:hint="AIzaSy... (Gemini API Key)"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_glass_primary"
                android:textColorHint="@color/text_glass_muted"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_api_key"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_glass_glow"
                android:text="Kalitni Saqlash"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Ovoz (Erkak Ovozi / Male Voice) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_liquid_glass"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="🎙️ AI Ovoz Tembri (Erkak Ovozi)"
                android:textColor="@color/text_glass_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="AI jiddiy, professional va ravon erkak ovozida o'zbek tilida javob beradi."
                android:textColor="@color/text_glass_secondary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_test_speech"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dark_fluid"
                android:text="🔊 Erkak Ovozini Sinab Ko'rish"
                android:textAllCaps="false"
                android:textColor="@color/siri_cyan"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 3. Tanish Tili -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_liquid_glass"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="🌐 Tanish Tili"
                android:textColor="@color/text_glass_primary"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/rg_languages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/rb_lang_uz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="O'zbek tili (uz-UZ)"
                    android:textColor="@color/text_glass_primary"
                    app:buttonTint="@color/siri_cyan" />

                <RadioButton
                    android:id="@+id/rb_lang_ru"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Русский язык (ru-RU)"
                    android:textColor="@color/text_glass_primary"
                    app:buttonTint="@color/siri_cyan" />

                <RadioButton
                    android:id="@+id/rb_lang_en"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="English (en-US)"
                    android:textColor="@color/text_glass_primary"
                    app:buttonTint="@color/siri_cyan" />
            </RadioGroup>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
