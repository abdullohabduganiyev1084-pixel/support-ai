<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_fluid"
    android:padding="24dp">

    <!-- Orqa fon suyuq nurlari -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.3"
        android:background="@drawable/btn_mic_glow" />

    <!-- Markaziy Siri uslubidagi Liquid Glass blok -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Animatsiyalik Siri Orb -->
        <FrameLayout
            android:id="@+id/frame_welcome_orb"
            android:layout_width="200dp"
            android:layout_height="200dp">

            <com.supportai.assistant.utils.SiriWaveOrbView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_welcome_logo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                app:cardCornerRadius="44dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#000000">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/support_ai_logo"
                    android:contentDescription="@string/app_name" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Sarlovha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-black"
            android:text="SUPPORT AI"
            android:textColor="@color/siri_cyan"
            android:textSize="32sp"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Aqlli Ovozli Boshqaruv Assistent"
            android:textColor="@color/text_glass_secondary"
            android:textSize="14sp" />

        <!-- Liquid Glass Karta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_liquid_glass"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Telefoningizdagi har qanday ilovani to'liq ovoz orqali boshqaring. Tugmalarni bosish shart emas — shunchaki ayting, AI bajaradi."
                android:textColor="@color/text_glass_primary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Pastdagi Liquid Glass Boshlash tugmasi -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_get_started"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_glass_glow"
        android:fontFamily="sans-serif-bold"
        android:text="@string/btn_get_started"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />

</RelativeLayout>
